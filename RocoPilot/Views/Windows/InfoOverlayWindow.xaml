<windowex:WindowEx
    x:Class="RocoPilot.Views.Windows.InfoOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowex="using:WinUIEx"
    Width="400"
    Height="48"
    mc:Ignorable="d">

    <Grid
        x:Name="OverlayRoot"
        Background="Transparent"
        PointerMoved="OverlayRoot_PointerMoved"
        PointerPressed="OverlayRoot_PointerPressed"
        PointerReleased="OverlayRoot_PointerReleased">
        <Border
            x:Name="InfoPanel"
            Width="156"
            Height="32"
            Padding="12,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#FF000000"
            BorderBrush="#24FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform
                    x:Name="IslandScale"
                    ScaleX="1"
                    ScaleY="1" />
            </Border.RenderTransform>

            <Grid>
                <Border
                    x:Name="PendingShinyAlert"
                    Padding="10,8"
                    Background="#E62B2416"
                    BorderBrush="#CCF59E0B"
                    BorderThickness="1"
                    CornerRadius="18"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Width="24"
                            Height="24"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Foreground="#FBBF24"
                            Glyph="&#xE7BA;" />

                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#FDE68A"
                                Text="发现异色精灵" />
                            <TextBlock
                                x:Name="PendingShinyAlertText"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#FFF7ED"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid
                    x:Name="CompactLayer"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Ellipse
                        x:Name="StateDot"
                        Width="7"
                        Height="7"
                        VerticalAlignment="Center"
                        Fill="#34D399" />

                    <StackPanel
                        x:Name="StatusContent"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform
                                x:Name="StatusShift"
                                Y="0" />
                        </StackPanel.RenderTransform>

                        <TextBlock
                            x:Name="StatusPrimaryText"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFFFF"
                            MaxLines="1"
                            Text="状态待识别"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            x:Name="StatusDetailText"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="#FF34D399"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</windowex:WindowEx>
