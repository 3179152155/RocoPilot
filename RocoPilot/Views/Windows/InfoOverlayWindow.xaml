<windowex:WindowEx
    x:Class="RocoPilot.Views.Windows.InfoOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowex="using:WinUIEx"
    Width="400"
    Height="60"
    mc:Ignorable="d">

    <Grid
        x:Name="OverlayRoot"
        Background="Transparent"
        PointerMoved="OverlayRoot_PointerMoved"
        PointerPressed="OverlayRoot_PointerPressed"
        PointerReleased="OverlayRoot_PointerReleased">
        <Border
            x:Name="InfoPanel"
            Height="52"
            Margin="8,6,8,2"
            Padding="14,0"
            Background="#FF000000"
            BorderBrush="#24FFFFFF"
            BorderThickness="1"
            CornerRadius="26"
            RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform
                    x:Name="IslandScale"
                    ScaleX="1"
                    ScaleY="1" />
            </Border.RenderTransform>

            <Grid>
                <Border
                    x:Name="PendingShinyAlert"
                    Padding="10,8"
                    Background="#E62B2416"
                    BorderBrush="#CCF59E0B"
                    BorderThickness="1"
                    CornerRadius="18"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Width="24"
                            Height="24"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Foreground="#FBBF24"
                            Glyph="&#xE7BA;" />

                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#FDE68A"
                                Text="发现异色精灵" />
                            <TextBlock
                                x:Name="PendingShinyAlertText"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#FFF7ED"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid
                    x:Name="CompactLayer"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse
                        x:Name="StateDot"
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="#34D399" />

                    <TextBlock
                        x:Name="StatusText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#FFFFFFFF"
                        MaxLines="1"
                        Text="状态待识别"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap">
                        <TextBlock.RenderTransform>
                            <TranslateTransform
                                x:Name="StatusShift"
                                Y="0" />
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <Border
                        x:Name="PollutionCounterIndicator"
                        Grid.Column="2"
                        Width="22"
                        Height="22"
                        Background="#2934D399"
                        BorderBrush="#5534D399"
                        BorderThickness="1"
                        CornerRadius="11"
                        ToolTipService.ToolTip="奇遇计数">
                        <FontIcon
                            x:Name="PollutionCounterIcon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="12"
                            Foreground="#34D399"
                            Glyph="&#xE9A3;" />
                    </Border>

                    <Border
                        x:Name="AutoBattleIndicator"
                        Grid.Column="3"
                        Width="22"
                        Height="22"
                        Background="#22FFFFFF"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        CornerRadius="11"
                        Opacity="0.72"
                        ToolTipService.ToolTip="自动战斗">
                        <FontIcon
                            x:Name="AutoBattleIcon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="12"
                            Foreground="#8B95A1"
                            Glyph="&#xF272;" />
                    </Border>

                    <StackPanel
                        x:Name="MagicPointPanel"
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="3">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="#8093A2"
                            Text="魔力" />
                        <TextBlock
                            x:Name="MagicPointText"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#86EFAC"
                            Text="0/6" />
                    </StackPanel>

                    <Border
                        Grid.Column="5"
                        Width="1"
                        Height="16"
                        VerticalAlignment="Center"
                        Background="#2EFFFFFF" />

                    <TextBlock
                        x:Name="UpdatedAtText"
                        Grid.Column="6"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="#99FFFFFF"
                        Text="--:--:--" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</windowex:WindowEx>
